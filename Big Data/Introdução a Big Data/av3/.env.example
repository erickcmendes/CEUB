# Copie para .env (scripts/setup.sh faz isso e preenche AIRFLOW_UID e a chave Fernet).
# Credenciais de laboratorio: troque antes de expor qualquer porta fora da maquina local.
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Configuracao lida pelos jobs (jobs/settings.py)
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=air-quality
SOURCE_KEY=raw/airquality.csv
PROCESSED_PREFIX=processed/airquality
REPORTS_PREFIX=reports
KAFKA_BOOTSTRAP=kafka1:9092
KAFKA_TOPIC=sensor_raw
KAFKA_PARTITIONS=3
